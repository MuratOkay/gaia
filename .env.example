# ---------------------------------------------------------------------------
# Gaia local environment. Copy to .env and fill in real values.
#   cp .env.example .env
# .env is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Gaia metadata store (PostgreSQL 18 + pgvector) ------------------------
GAIA_METADATA_DB=gaia
GAIA_METADATA_USER=gaia
GAIA_METADATA_PASSWORD=change-me-gaia
GAIA_METADATA_HOST=localhost
GAIA_METADATA_PORT=5433
# DSN assembled by the app; provided explicitly here for convenience.
GAIA_METADATA_URL=postgresql+asyncpg://gaia:change-me-gaia@localhost:5433/gaia

# --- Target database (SQL Server 2025, container "sql1") -------------------
# The database itself is restored by the owner; Gaia never creates it.
GAIA_TARGET=demo_mssql
GAIA_TARGET_DATABASE=CHANGE_ME_AFTER_RESTORE
GAIA_TARGET_HOST=127.0.0.1
GAIA_TARGET_PORT=1433
GAIA_TARGET_USER=gaia_ro
GAIA_TARGET_PASSWORD=change-me-gaia-ro

# --- PostgreSQL development target (D25) ------------------------------------
# A synthetic database generated by infra/pg-target/seed.py. Separate server
# from the metadata store. Host/port/database/user have defaults in gaia.yaml;
# only the read-only password is required.
GAIA_PG_TARGET_HOST=127.0.0.1
GAIA_PG_TARGET_PORT=5434
GAIA_PG_TARGET_DATABASE=gaia_target_pg
GAIA_PG_TARGET_USER=gaia_ro
GAIA_PG_TARGET_PASSWORD=change-me-gaia-pg-ro
# Owner/superuser of the target container; used ONLY by the seed script and
# the container itself, never by Gaia.
GAIA_PG_TARGET_ADMIN_USER=postgres
GAIA_PG_TARGET_ADMIN_PASSWORD=change-me-pg-target-admin
GAIA_PG_TARGET_ADMIN_URL=postgresql://postgres:<change-me-pg-target-admin>@127.0.0.1:5434/gaia_target_pg

# --- Reasoning LLM ---------------------------------------------------------
# provider: deepseek | ollama
GAIA_LLM_PROVIDER=deepseek
# OpenAI-compatible base URL; the client appends /chat/completions.
GAIA_LLM_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
DEEPSEEK_API_KEY=
# Model id as reported by GET {GAIA_LLM_BASE_URL}/models
GAIA_LLM_MODEL=deepseek-flash

# --- Embeddings (local Ollama) --------------------------------------------
GAIA_EMBEDDINGS_BASE_URL=http://localhost:11435
GAIA_EMBEDDINGS_MODEL=bge-m3
GAIA_EMBEDDINGS_DIMENSIONS=1024

# --- Cache -----------------------------------------------------------------
GAIA_REDIS_URL=redis://localhost:6380/0

# --- Data sources added at runtime (Phase 4F) --------------------------------
# Encrypts their credentials (AES-256-GCM). 32 bytes, URL-safe base64: `make master-key`.
# Losing it makes stored credentials unreadable (re-add them); never commit it.
GAIA_MASTER_KEY=
# During a key rotation: the previous key(s), comma-separated (then make datasource ARGS=rotate-key)
GAIA_MASTER_KEY_PREVIOUS=

